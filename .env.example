# ==============================================================================
# Unified Dual-Core Enterprise Platform — Environment Configuration Template
# Problem Statement: SIH26006 (Maritime Freight Forecasting & Legal Metrology)
# Copy this file to .env before starting the production or development system.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / H2)
# ------------------------------------------------------------------------------
POSTGRES_DB=lmchecker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lmchecker
# For H2 in-memory local testing:
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/lmchecker;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH

# ------------------------------------------------------------------------------
# 2. JWT SECURITY & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# Secret must be a secure 256-bit hexadecimal key in production:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
# Set to 'true' in HTTPS production environments to enforce SameSite=Lax Secure HttpOnly cookies
APP_SECURITY_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 / OPENID CONNECT (OIDC) CREDENTIALS
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
APP_OAUTH2_DEFAULT_ROLE=VIEWER

# ------------------------------------------------------------------------------
# 4. EMAIL (SMTP) & ACCOUNT NOTIFICATION DELIVERY
# Used for single-use verification links and password resets.
# When credentials are empty, the platform safely logs verification tokens to the console.
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD=your-app-specific-smtp-password
MAIL_SMTP_AUTH=true
MAIL_TLS_ENABLE=true
OTP_DELIVERY_MODE=demo

# ------------------------------------------------------------------------------
# 5. SERVICE PORTS & CORS NETWORKING
# ------------------------------------------------------------------------------
PORT=8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. STORAGE & AI DIRECTORIES
# ------------------------------------------------------------------------------
STORAGE_UPLOAD_DIR=./storage/uploads
