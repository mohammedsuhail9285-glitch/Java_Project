@echo off
title RegTech Sentinel - Shutdown
echo =================================================================
echo  Stopping RegTech Sentinel Services...
echo =================================================================

echo Stopping port 8000 (AI Microservice)...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :8000 ^| findstr LISTENING') do (
    taskkill /F /PID %%a 2>nul
)

echo Stopping port 8080 (Backend Service)...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :8080 ^| findstr LISTENING') do (
    taskkill /F /PID %%a 2>nul
)

echo Stopping port 5173 (Frontend Service)...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :5173 ^| findstr LISTENING') do (
    taskkill /F /PID %%a 2>nul
)

echo Stopping port 3000 (Frontend Service)...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :3000 ^| findstr LISTENING') do (
    taskkill /F /PID %%a 2>nul
)

echo All RegTech Sentinel services stopped.
pause
